{
  "name": "twake-directory-manager",
  "version": "0.15.0",
  "description": "Administration console for an enterprise directory served by ldap-rest",
  "keywords": [
    "ldap",
    "directory",
    "administration",
    "twake"
  ],
  "homepage": "https://github.com/linagora/twake-directory-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/twake-directory-manager.git"
  },
  "license": "AGPL-3.0",
  "author": "Xavier Guimard <yadd@debian.org>",
  "type": "module",
  "main": "dist/twake-directory-manager.js",
  "module": "dist/twake-directory-manager.esm.js",
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . && node scripts/check-compat.mjs",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "version": "node scripts/sync-chart-version.mjs && git add package.json package-lock.json helm/twake-directory-manager/Chart.yaml",
    "typecheck": "tsc -p tsconfig.json"
  },
  "overrides": {
    "glob": "^14.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "mocha": {
      "minimatch": "^11.0.1"
    },
    "test-exclude": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@happy-dom/global-registrator": "^21.0.4",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.9",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "browserslist": "^4.29.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^14.0.0",
    "happy-dom": "^21.0.4",
    "ldap-rest": "^2.3.0",
    "lightningcss": "^1.33.0",
    "mocha": "^12.0.3",
    "nock": "^14.0.10",
    "prettier": "^3.8.0",
    "rollup": "^4.68.3",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.2"
  ],
  "ldapRest": {
    "min": "2.1.0",
    "tested": "2.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "re2@1.27.1": true
  }
}
