{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One pull request a week for the build and test toolchain",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "The e2e package is a project of its own",
      "matchFileNames": ["e2e/**"],
      "groupName": "e2e"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "ldap-rest is what the console runs on: a new major changes the supported range (#225) and waits for a go on the dashboard",
      "matchDepNames": ["ghcr.io/linagora/ldap-rest", "ldap-rest"],
      "groupName": "ldap-rest"
    },
    {
      "matchDepNames": ["ghcr.io/linagora/ldap-rest", "ldap-rest"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The OpenLDAP and Dex of the QA stack: the osixia 2.4 image of the compatibility check, the OpenLDAP release the QA image builds (2.6, the long-term line; 2.7 is a QA_OPENLDAP_VERSION away, #399), and Dex",
      "matchDepNames": ["osixia/openldap", "openldap", "ghcr.io/dexidp/dex"],
      "groupName": "qa images"
    },
    {
      "description": "The Helm version azure/setup-helm installs, which Renovate reads from the workflows itself",
      "matchDepNames": ["helm"],
      "groupName": "helm"
    },
    {
      "description": "The QA image follows OpenLDAP's long-term 2.6 line",
      "matchDepNames": ["openldap"],
      "allowedVersions": "<2.7"
    }
  ],
  "customManagers": [
    {
      "description": "The images build.sh pulls for the QA stack (docker-compose.yaml and the Dockerfile's ARG have managers of their own)",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/qa-environment/build\\.sh$/"],
      "matchStrings": [
        "(?<depName>osixia/openldap|ghcr\\.io/dexidp/dex):(?<currentValue>[^\\s;]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "The ldap-rest version the console is tested against (package.json ldapRest.tested), bumped with the Dockerfile's image so that check-compat agrees",
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"tested\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "ghcr.io/linagora/ldap-rest",
      "datasourceTemplate": "docker"
    },
    {
      "description": "The OpenLDAP release the QA image builds (scripts/qa-environment/openldap/Dockerfile), read from openldap.org's release directory",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/qa-environment/openldap/Dockerfile$/"],
      "matchStrings": [
        "ARG OPENLDAP_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "openldap",
      "datasourceTemplate": "custom.openldap",
      "extractVersionTemplate": "^openldap-(?<version>\\d+\\.\\d+\\.\\d+)\\.tgz$"
    }
  ],
  "customDatasources": {
    "openldap": {
      "defaultRegistryUrlTemplate": "https://www.openldap.org/software/download/OpenLDAP/openldap-release/",
      "format": "html"
    }
  }
}
