{
  "name": "@twake-directory-manager/e2e",
  "private": true,
  "description": "End to end tests of the Twake Directory Manager console (Playwright). Standalone package, run by the e2e job of CI.",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stack:start": "./scripts/start.sh",
    "stack:stop": "./scripts/stop.sh",
