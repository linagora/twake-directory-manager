# Seed data of the QA environment, loaded by start.sh under dc=example,dc=com: the branches the
# Twake schemas of ldap-rest name, their nomenclatures, an organization tree with a global and
# two local administrators, accounts in every organization and a few groups.
#
# Every account signs in with the password "secret".

# ------------------------------------------------------------------------------------- branches
dn: ou=users,dc=example,dc=com
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=example,dc=com
objectClass: organizationalUnit
ou: groups

dn: ou=positions,dc=example,dc=com
objectClass: organizationalUnit
ou: positions

dn: ou=nomenclature,dc=example,dc=com
objectClass: organizationalUnit
ou: nomenclature

