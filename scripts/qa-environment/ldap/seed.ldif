# ---------------------------------------------------------------------------- organization tree
# admin administers the whole directory, sophie.martin Sales, eric.dubois Engineering; nobody
# administers Human Resources but admin. Transit is DM_AUTHZ_TRANSIT_BRANCH.
dn: ou=organization,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
objectClass: twakeDepartment
ou: organization
description: Example Corp
twakeDepartmentPath: organization
twakeLocalAdminLink: uid=admin,ou=users,dc=example,dc=com
twakeDomainLink: dc=example,ou=domains,ou=nomenclature,dc=example,dc=com

dn: ou=Sales,ou=organization,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
objectClass: twakeDepartment
ou: Sales
description: Sales department
l: Paris
twakeDepartmentPath: Sales
twakeLocalAdminLink: uid=sophie.martin,ou=users,dc=example,dc=com
twakeManagerLink: uid=sophie.martin,ou=users,dc=example,dc=com

